
# Database (PostgreSQL with pgvector extension)
# DATABASE_URL does NOT belong here — put it in `.env` (see `.env.example`).
# The Prisma CLI reads only `.env`, so a URL set here is invisible to
# `prisma migrate` / `prisma db seed`, and those commands would silently fall
# through to whatever `.env` holds — including the shared remote dev database.

# Encryption key for stored mailbox passwords and API keys
# (generate with: openssl rand -hex 32; never change it once set)
EMAIL_ENCRYPTION_KEY=

# Mailtrap Sandbox - optional dev/staging email testing (alternative to Resend)
# Generate a token from your Mailtrap inbox settings: https://mailtrap.io
MAILTRAP_API_KEY=

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional for local dev — Email OTP works without it)
GOOGLE_ID=
GOOGLE_SECRET=

# LinkedIn (recommended: direct OAuth — avoids Vercel Connect token exchange issues)
# Add redirect URL in LinkedIn app: {NEXT_PUBLIC_APP_URL}/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional scopes — default is openid profile email only.
# LINKEDIN_ORG_SCOPES=true
# LINKEDIN_OAUTH_SCOPES=openid profile email
# Lead Sync webhook (LinkedIn → CRM leads): POST /api/linkedin/leads/webhook with Authorization: Bearer <secret>
# LINKEDIN_LEADS_WEBHOOK_SECRET=

# Public website lead intake — same secret as CRM_LEADS_API_KEY on vensailabs.in
WEBSITE_LEADS_API_KEY=

# Legacy SMTP/IMAP env vars (optional — use Resend mailboxes below)
# EMAIL_HOST=
# IMAP_HOST=

# Allow mailbox (IMAP/SMTP) and plugin HTTP connections to private IPs
MAIL_ALLOW_PRIVATE_HOSTS=
PLUGIN_HTTP_ALLOW_PRIVATE_HOSTS=


#NEXT ENV for Client part of App
NEXT_PUBLIC_APP_NAME=VenSai CRM
NEXT_PUBLIC_APP_V=0.0.3-beta
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domain for the fallback invoice sender (invoices@<domain>) when EMAIL_FROM is empty
NEXT_PUBLIC_APP_DOMAIN=
# Should match NEXT_PUBLIC_APP_URL in production (Better Auth callbacks)
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-production-domain.example
NEXT_PUBLIC_NEXT_VERSION="14.0.4"
NEXT_PUBLIC_GITHUB_REPO_URL="https://github.com/pdovhomilja/nextcrm-app"
NEXT_PUBLIC_GITHUB_ISSUES_URL=""
NEXT_PUBLIC_GITHUB_TOKEN=


#NEXTCRM (generate with: openssl rand -base64 32)
NEXTCRM_TOKEN=

#AI (empty = use keys saved in the admin panel)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

#Discord
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.com/invite/Dd4Aj6S4Dz"

# =============================================================================
# EMAIL (Resend + Inngest) — configure ONLY here / Vercel env (not Admin UI)
# =============================================================================
# 1) Resend: verify domain, enable Receiving (MX), create API key + email.received webhook
# 2) Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/resend/inbound
# 3) Inngest: connect Vercel app, copy keys below; sync serves /api/inngest
# 4) Admin portal: only creates employees/mailboxes — no API keys stored there
# =============================================================================

ORG_EMAIL_DOMAIN=yourcompany.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourcompany.com
EMAIL_FROM=noreply@yourcompany.com
# Signing secret from Resend → Webhooks → your inbound webhook (whsec_…)
RESEND_INBOUND_WEBHOOK_SECRET=
# Alias accepted by the app (same value as above):
# RESEND_WEBHOOK_SECRET=

# INNGEST (local dev server: INNGEST_DEV=1, see docker-compose.dev.yml)
INNGEST_DEV=1
INNGEST_ID=nextcrm
INNGEST_APP_NAME=VenSai CRM
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

#MINIO (MINIO_PUBLIC_ENDPOINT = URL browsers use; empty = same as MINIO_ENDPOINT)
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=


#Playwright E2E Test Credentials
# The test user is created automatically when you run: pnpm prisma db seed
# E2E tests use Email OTP — the test setup intercepts OTP from the database
TEST_USER_EMAIL=admin@domain.com

# Required for E2B enrichment
E2B_API_KEY=e2b_***
E2B_ENRICHMENT_TEMPLATE=nextcrm-enrichment
