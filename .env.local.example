
# Database (PostgreSQL with pgvector extension)
# DATABASE_URL does NOT belong here — put it in `.env` (see `.env.example`).
# The Prisma CLI reads only `.env`, so a URL set here is invisible to
# `prisma migrate` / `prisma db seed`, and those commands would silently fall
# through to whatever `.env` holds — including the shared remote dev database.

# Encryption key for stored mailbox passwords and API keys
# (generate with: openssl rand -hex 32; never change it once set)
EMAIL_ENCRYPTION_KEY=

# Mailtrap Sandbox - optional dev/staging email testing (alternative to Resend)
# Generate a token from your Mailtrap inbox settings: https://mailtrap.io
MAILTRAP_API_KEY=

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap admin — personal login, work inbox, password (seed + Vercel build after migrate)
BOOTSTRAP_ADMIN_EMAIL=jaybabu0610@gmail.com
BOOTSTRAP_ADMIN_WORK_EMAIL=ceo@vensailabs.in
BOOTSTRAP_ADMIN_PASSWORD=J@yandra06
# Set on Vercel Production env. BOOTSTRAP_ADMIN_SKIP=1 disables auto-run on deploy.

# Google OAuth (optional for local dev — Email OTP works without it)
GOOGLE_ID=
GOOGLE_SECRET=

# Canva Connect (https://www.canva.com/developers/)
# Redirect URL: {NEXT_PUBLIC_APP_URL}/api/canva/callback
# Scopes: profile:read design:meta:read design:content:read design:content:write
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# Brand template id for the offer letterhead (or set it in Hiring). Fields:
# candidate_name, job_title, employment_type, start_date, compensation, email, phone, location
# CANVA_OFFER_BRAND_TEMPLATE_ID=

# LinkedIn (recommended: direct OAuth — avoids Vercel Connect token exchange issues)
# Add redirect URL in LinkedIn app: {NEXT_PUBLIC_APP_URL}/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional scopes — default is openid profile email only.
# LINKEDIN_ORG_SCOPES=true
# LINKEDIN_OAUTH_SCOPES=openid profile email
# Lead Sync webhook (LinkedIn → CRM leads): POST /api/linkedin/leads/webhook with Authorization: Bearer <secret>
# LINKEDIN_LEADS_WEBHOOK_SECRET=
# AI scores inbound LinkedIn leads (Inngest). Set 0 to disable.
# LINKEDIN_AI_QUALIFY=1
# Static ICP text when Mem0 is empty (also editable in Admin → LinkedIn)
# LINKEDIN_ICP_BRIEF=
# Mem0 user id namespace for shared ICP memories (default nextcrm:linkedin-icp)
# LINKEDIN_MEM0_USER_ID=
# Auto-add hot leads (score ≥78) to campaign targets table
# LINKEDIN_AUTO_CAMPAIGN_TARGET=0

# Upstash Redis (Vercel → Integrations → Upstash **Redis**, not “Upstash Search”).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional: force Postgres-only (no Redis calls) — e.g. free tier exhausted
# REDIS_CACHE_DISABLED=1
# Caches: unified search, comboboxes, Cmd+K docs, mailbox lists. On miss/error/quota → Postgres always works.

# Public website lead intake — same secret as CRM_LEADS_API_KEY on vensailabs.in
WEBSITE_LEADS_API_KEY=

# Legacy SMTP/IMAP env vars (optional — use Resend mailboxes below)
# EMAIL_HOST=
# IMAP_HOST=

# Allow mailbox (IMAP/SMTP) and plugin HTTP connections to private IPs
MAIL_ALLOW_PRIVATE_HOSTS=
PLUGIN_HTTP_ALLOW_PRIVATE_HOSTS=


#NEXT ENV for Client part of App
NEXT_PUBLIC_APP_NAME=VenSai CRM
NEXT_PUBLIC_APP_V=0.0.3-beta
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: absolute base for logo URLs in outbound email (defaults to NEXT_PUBLIC_APP_URL, then crm.vensailabs.in)
# NEXT_PUBLIC_BRAND_LOGO_URL=https://crm.vensailabs.in
# Domain for the fallback invoice sender (invoices@<domain>) when EMAIL_FROM is empty
NEXT_PUBLIC_APP_DOMAIN=
# Should match NEXT_PUBLIC_APP_URL in production (Better Auth callbacks)
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-production-domain.example
NEXT_PUBLIC_NEXT_VERSION="14.0.4"
NEXT_PUBLIC_GITHUB_REPO_URL="https://github.com/pdovhomilja/nextcrm-app"
NEXT_PUBLIC_GITHUB_ISSUES_URL=""
NEXT_PUBLIC_GITHUB_TOKEN=


#NEXTCRM (generate with: openssl rand -base64 32)
NEXTCRM_TOKEN=

# Mem0 — long-term memory for CRM AI (assistant, compose, campaigns). Same API key as OpenClaw mem0 plugin.
# Get a key: https://app.mem0.ai — or `mem0 init --agent` for agent setup.
# MEM0_API_KEY=
# Optional namespace prefix for user_id (default: nextcrm:<crm-user-uuid>)
# MEM0_USER_ID_PREFIX=

# AI — see docs/AI_SETUP.md (feature → provider matrix + OpenRouter free models)
# OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=https://crm.vensailabs.in
# OPENROUTER_APP_NAME=VenSai CRM
# Optional override (defaults built into app if unset):
# LLM_OPENROUTER_FREE_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free,...
# LLM_GROQ_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
# LLM_GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
# LLM_OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# GEMINI_API_KEY=              # also GOOGLE_GENERATIVE_AI_API_KEY — enables polish step in workflow
# GROQ_API_KEY=                # or Profile / Admin → LLM Keys (Groq ≠ xAI Grok)
# LLM_WORKFLOW=1               # draft (chain) + Gemini polish; set 0 for fastest single model
# LLM_CAMPAIGN_EMAIL_REFINE=1  # third pass: OpenAI fixes JSON (needs OPENAI_API_KEY)
# LLM_CHAIN_CAMPAIGN_EMAIL=groq,openrouter,gemini,openai
# Embeddings + enrichment (empty = use keys saved in the admin panel)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

#Discord
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.com/invite/Dd4Aj6S4Dz"

# =============================================================================
# EMAIL (Resend + Inngest) — configure ONLY here / Vercel env (not Admin UI)
# =============================================================================
# 1) Resend: verify domain, enable Receiving (MX), create API key + email.received webhook
# 2) Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/resend/inbound
# 3) Inngest: connect Vercel app, copy keys below; sync serves /api/inngest
# 4) Admin portal: only creates employees/mailboxes — no API keys stored there
# =============================================================================

ORG_EMAIL_DOMAIN=yourcompany.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourcompany.com
EMAIL_FROM=noreply@yourcompany.com
# Signing secret from Resend → Webhooks → your inbound webhook (whsec_…)
RESEND_INBOUND_WEBHOOK_SECRET=
# Alias accepted by the app (same value as above):
# RESEND_WEBHOOK_SECRET=

# Vercel Cron (Hobby allows a daily job). openssl rand -base64 32
# Set the same value in the Vercel project. Vercel sends it to /api/cron/exchange-rates.
CRON_SECRET=

# INNGEST (local dev server: INNGEST_DEV=1, see docker-compose.dev.yml)
INNGEST_DEV=1
INNGEST_ID=nextcrm
INNGEST_APP_NAME=VenSai CRM
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

#MINIO (MINIO_PUBLIC_ENDPOINT = URL browsers use; empty = same as MINIO_ENDPOINT)
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=


#Playwright E2E Test Credentials
# The test user is created automatically when you run: pnpm prisma db seed
# E2E tests use Email OTP — the test setup intercepts OTP from the database
TEST_USER_EMAIL=admin@domain.com

# Required for E2B enrichment
E2B_API_KEY=e2b_***
E2B_ENRICHMENT_TEMPLATE=nextcrm-enrichment
