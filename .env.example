# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# PostgreSQL — local Docker (`pnpm db:up`):
DATABASE_URL="postgresql://nextcrm:nextcrm@localhost:5433/nextcrm"
#
# Supabase ↔ Vercel integration (auto-injected on Vercel — usually no manual copy needed):
#   Runtime:  POSTGRES_PRISMA_URL or POSTGRES_URL (pooled, port 6543)
#   Migrations (build): POSTGRES_URL_NON_POOLING (direct, port 5432)
# The app prefers DATABASE_URL if set; otherwise it uses those Supabase vars.
# Optional override for migrate deploy: DIRECT_DATABASE_URL=
# Optional: cap pg pool size per serverless instance (default 2 on Vercel).
# PG_POOL_MAX=2
# Optional: strict TLS verification for remote Postgres (default off for Supabase pooler on Node).
# Runtime pg pool strips sslmode=require from the URL (pg treats it as verify-full).
# DATABASE_SSL_REJECT_UNAUTHORIZED=1
# Remote databases go here too — this file, never `.env.local`, because the
# Prisma CLI reads only `.env`. Keep the local line above and comment/uncomment:
#DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?schema=public"
# Note: `pnpm db:migrate`, `db:seed` and `db:reset` refuse to run unless this
# points at localhost (scripts/assert-local-db.sh).

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Bootstrap admin (seed, `pnpm bootstrap:admin`, and automatically after migrate on Vercel build)
BOOTSTRAP_ADMIN_EMAIL=jaybabu0610@gmail.com
BOOTSTRAP_ADMIN_WORK_EMAIL=ceo@vensailabs.in
BOOTSTRAP_ADMIN_PASSWORD=J@yandra06
# BOOTSTRAP_ADMIN_NAME=Jayandra
# BOOTSTRAP_ADMIN_SKIP=1

# Google OAuth
GOOGLE_ID="your-google-client-id"
GOOGLE_SECRET="your-google-client-secret"

# Public website lead intake (POST /api/public/leads). Must match CRM_LEADS_API_KEY on vensailabs.in.
WEBSITE_LEADS_API_KEY=

# Email Service (Resend). Leave the key empty to use the one saved in
# Admin > Resend; an env value always wins over the admin panel.
RESEND_API_KEY=
EMAIL_FROM=                # verified sender for login codes, e.g. noreply@yourdomain.com

# AI. Leave empty to use keys saved in the admin panel.
# Campaign AI chain: OPENROUTER_API_KEY → GROQ → GEMINI → OPENAI (see .env.local.example)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Firecrawl (contact enrichment)
FIRECRAWL_API_KEY=            # get from https://firecrawl.dev

# MinIO / S3 object storage
# MINIO_ENDPOINT is what the server uses; MINIO_PUBLIC_ENDPOINT is what
# browsers use (presigned uploads and file links). Leave it empty when both
# are the same URL.
MINIO_ENDPOINT="https://your-minio-host"
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET="your-bucket-name"
MINIO_ACCESS_KEY="your-access-key"
MINIO_SECRET_KEY="your-secret-key"

# Encrypts stored mailbox passwords and API keys — generate with: openssl rand -hex 32
# Set once and never change it, or the stored values become unreadable.
EMAIL_ENCRYPTION_KEY=

# Campaigns — Resend email sending
RESEND_WEBHOOK_SECRET=     # Resend webhook signing secret (whsec_…, Svix-signed)
RESEND_FROM_EMAIL=         # e.g. noreply@yourdomain.com

# Google Calendar sync — Workspace-internal OAuth app
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Seed the demo CRM dataset on `pnpm db:seed` (1 = yes)
SEED_DEMO_DATA=
